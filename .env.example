# Copy this file to .env and fill in your values.

# Required: your Anthropic API key
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (defaults shown)
# CLAUDE_MODEL=claude-opus-4-6
# RENDER_DPI=200
# TESSERACT_LANG=eng
# TESSERACT_LEGACY_TESSDATA=~/tessdata_legacy   # needed only for --engine tesseract-legacy
# DATA_ROOT=./data
# OLLAMA_MODEL=glm-ocr     # model for --engine ollama, e.g. qwen3-vl:8b (run: ollama pull <model>)
# OLLAMA_HOST=http://localhost:11434
# VLLM_HOST=http://localhost:8000   # --engine vllm: OpenAI-compatible server (e.g. vllm serve <model>)
# VLLM_MODEL=                       # empty = the one model the server serves
# VLLM_CONCURRENCY=16               # pages OCR'd in parallel
# SURYA_DEVICE=cpu        # "auto" to use the GPU (mps/cuda) if available; "mps" or "cuda" to force one
